---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Contact from '../../components/Contact.astro';
import { url } from '../../data/site';

export async function getStaticPaths() {
  const all = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
  return all.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, next: all[(i + 1) % all.length] } }));
}

const { entry, next } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;
const meta = [
  ['Role', d.role],
  ['Year', d.year],
  ['Team', d.team],
  ['Platform', d.platform],
].filter(([, v]) => v);
---
<Base title={`${d.title} — Daniela Castro`} description={d.summary ?? d.tagline}>
  <article class="case" style={`--accent:${d.accent};--accent-ink:${d.accentInk}`}>
    <header class="case__head wrap">
      <a href={url('/#work')} class="case__back eyebrow" data-magnetic>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H5m0 0 6-6m-6 6 6 6" stroke="currentColor" stroke-width="1.8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
        All work
      </a>
      <p class="eyebrow case__tag" data-reveal>{d.tagline}</p>
      <h1 class="case__title" transition:name={`title-${entry.id}`}>{d.title}</h1>
      {d.summary && <p class="case__summary" data-reveal>{d.summary}</p>}
      <dl class="case__meta" data-reveal>
        {meta.map(([k, v]) => (<div><dt>{k}</dt><dd>{v}</dd></div>))}
      </dl>
    </header>

    <div class="case__cover wrap">
      <div class="case__cover-inner">
        <img src={url(d.cover)} alt={d.coverAlt} transition:name={`cover-${entry.id}`} data-parallax="soft" />
      </div>
    </div>

    <div class="case__body wrap prose" data-prose>
      <Content />
    </div>

    <a href={url(`work/${next.id}/`)} class="next wrap" data-cursor-label="Next" style={`--cursor-bg:${next.data.accent};--cursor-ink:${next.data.accentInk}`}>
      <span class="eyebrow">Next project</span>
      <span class="next__title">{next.data.title}</span>
      <span class="next__tag">{next.data.tagline}</span>
      <span class="next__preview" aria-hidden="true"><img src={url(next.data.cover)} alt="" loading="lazy" /></span>
    </a>
  </article>
  <Contact />
</Base>

<style>
  .case__head { padding-top: clamp(120px, 18vh, 200px); padding-bottom: clamp(40px, 6vw, 72px); }
  .case__back { display: inline-flex; align-items: center; gap: 8px; margin-bottom: clamp(32px, 6vh, 64px); color: #444; }
  .case__back svg { width: 18px; height: 18px; transition: transform .4s var(--ease-out); }
  .case__back:hover svg { transform: translateX(-4px); }
  .case__tag { margin: 0 0 12px; color: #555; }
  .case__title {
    margin: 0; font-family: var(--serif); font-weight: 300;
    font-size: clamp(64px, 13vw, 200px); line-height: .9; letter-spacing: -0.03em;
    width: fit-content;
  }
  .case__summary { margin: 28px 0 0; max-width: 44ch; font-family: var(--display); font-weight: 600; font-size: clamp(22px, 2.4vw, 30px); line-height: 1.25; letter-spacing: -0.01em; }
  .case__meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 20px; margin: clamp(40px, 6vw, 64px) 0 0; padding-top: 24px; border-top: 1px solid var(--line); }
  .case__meta dt { font-size: 12px; letter-spacing: .12em; text-transform: uppercase; color: var(--muted); margin-bottom: 6px; }
  .case__meta dd { margin: 0; font-weight: 500; }

  .case__cover-inner { position: relative; overflow: hidden; border-radius: var(--radius); aspect-ratio: 16 / 10; background: var(--accent); }
  .case__cover-inner img { width: 100%; height: 100%; object-fit: cover; }

  .case__body { max-width: 860px; padding-block: clamp(64px, 10vw, 140px); }
  .prose :global(h2) { font-family: var(--display); font-weight: 800; font-size: clamp(32px, 4vw, 52px); letter-spacing: -0.025em; line-height: 1; margin: 2em 0 .6em; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-family: var(--display); font-weight: 600; font-size: 26px; margin: 1.6em 0 .4em; }
  .prose :global(p), .prose :global(li) { font-size: 20px; line-height: 1.6; color: #222; }
  .prose :global(ul) { padding-left: 1.1em; }
  .prose :global(li::marker) { color: var(--accent); }
  .prose :global(blockquote) {
    margin: 2em 0; padding: 0; border: 0;
    font-family: var(--serif); font-style: italic; font-weight: 300; font-size: clamp(30px, 4vw, 48px); line-height: 1.15; color: var(--ink);
  }
  .prose :global(blockquote p) { font-size: inherit; line-height: inherit; color: inherit; margin: 0; }
  .prose :global(img) { width: 100%; border-radius: var(--radius); margin: 1.5em 0; background: var(--soft); }
  .prose :global(p:has(> img:only-child)) { margin-inline: clamp(-120px, -8vw, 0px); }

  .next {
    position: relative; display: grid; gap: 8px; justify-items: start;
    padding-block: clamp(64px, 10vw, 120px); border-top: 1px solid var(--line);
  }
  .next .eyebrow { color: #555; }
  .next__title { font-family: var(--serif); font-weight: 300; font-size: clamp(56px, 11vw, 160px); line-height: .95; letter-spacing: -0.03em; transition: color .4s; }
  .next:hover .next__title { color: var(--cursor-bg); }
  .next__tag { color: #555; font-size: 18px; }
  .next__preview {
    position: absolute; right: var(--gutter); top: 50%; width: clamp(180px, 24vw, 340px); aspect-ratio: 4/3;
    border-radius: 18px; overflow: hidden; translate: 0 -50%; rotate: 4deg; scale: .6; opacity: 0;
    transition: scale .6s var(--ease-out), opacity .4s, rotate .6s var(--ease-out); pointer-events: none;
  }
  .next__preview img { width: 100%; height: 100%; object-fit: cover; }
  .next:hover .next__preview { scale: 1; opacity: 1; rotate: -3deg; }
  @media (max-width: 760px) { .next__preview { display: none; } }
</style>
