---
import { site, url } from '../data/site';
---
<footer class="contact frame" aria-labelledby="contact-title">
  <h2 id="contact-title" class="sr-only">Contact</h2>
  <ul class="socials" role="list">
    <li><a href={site.dribbble} target="_blank" rel="noopener"><img src={url('images/dribbble.svg')} alt="Dribbble" width="30" height="30" /></a></li>
    <li><a href={site.linkedin} target="_blank" rel="noopener"><img src={url('images/linkedin.svg')} alt="LinkedIn" width="30" height="30" /></a></li>
  </ul>
  <p class="hello">Want to say hello? <a href={`mailto:${site.email}`}>{site.email}</a></p>

  <div class="shapes" aria-hidden="true" data-shapes>
    <span class="shape shape--a"></span>
    <span class="shape shape--b"></span>
    <span class="shape shape--c"></span>
  </div>
</footer>

<style>
  .contact { height: 280px; overflow: hidden; }
  .socials { list-style: none; margin: 0; padding: 80px 0 0; display: flex; justify-content: center; gap: 67px; }
  .socials img { width: 30px; height: 30px; }
  .hello { margin-top: 20px; text-align: center; font-weight: 500; font-size: 16px; line-height: 20.8px; }
  .hello a:hover { text-decoration: underline; text-underline-offset: 3px; }

  .shapes { position: absolute; left: 0; right: 0; top: 219px; display: grid; grid-template-columns: repeat(3, 1fr); }
  .shape { display: block; aspect-ratio: 1; }
  .shape--a { background: var(--green); border-radius: 40px; }
  .shape--b { background: var(--orange); }
  .shape--c { background: var(--lilac); border-radius: 999px; }

  @media (min-width: 800px) {
    .contact { height: 340px; }
    .socials { padding-top: 64px; }
    .hello { margin-top: 32px; }
    .shapes { top: 271px; }
    .shape--a { border-radius: 100px; }
  }
</style>
