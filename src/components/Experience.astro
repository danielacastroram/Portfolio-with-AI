---
import { experience } from '../data/site';
---
<section class="exp frame" aria-labelledby="exp-title">
  <div class="exp__side">
    <div class="exp__head">
      <h2 id="exp-title" class="exp__title">Experience</h2>
    </div>
  </div>
  <ol class="exp__list" role="list">
    {experience.map((job) => (
      <li class="exp__row" data-reveal>
        <p class="exp__company">{job.company}</p>
        <p class="exp__role">{job.role}</p>
        <p class="exp__period">{job.period}</p>
      </li>
    ))}
  </ol>
</section>

<style>
  .exp { padding: 31px 24px 112px; }
  .exp__head { padding-top: 40px; }
  .exp__head::before { content: ''; display: block; height: 1px; background: #000; margin-bottom: 47px; }
  .exp__title {
    margin: 0; font-family: var(--display); font-weight: 800;
    font-size: 32px; line-height: 25.6px; letter-spacing: -0.025em;
  }

  .exp__list { list-style: none; margin: 65px 0 0; padding: 0; }
  .exp__company { font-size: 18px; line-height: 21.6px; }
  .exp__role { margin-top: 16.4px; font-family: var(--display); font-weight: 600; font-size: 20px; line-height: 20px; letter-spacing: -0.016em; }
  .exp__period { margin-top: 16px; font-size: 18px; line-height: 21.6px; color: var(--muted); }
  .exp__row + .exp__row { margin-top: 53.4px; padding-top: 59px; border-top: 1px solid var(--line); }

  /* Title column sticks while the list scrolls */
  @media (min-width: 800px) {
    .exp {
      display: grid; grid-template-columns: 338px 337px; column-gap: 45px; align-items: start;
      padding: 120px 40px 176px;
    }
    .exp__side { align-self: stretch; }
    .exp__head { position: sticky; top: 0; }
    .exp__head::before { margin-bottom: 48px; }
    .exp__title { font-size: 64px; line-height: 51.2px; letter-spacing: -0.0125em; }
    .exp__list { margin-top: 81px; }
    .exp__company { font-size: 20px; line-height: 24px; }
    .exp__role { margin-top: 16px; font-size: 24px; line-height: 24px; letter-spacing: -0.0133em; }
    .exp__period { margin-top: 16px; font-size: 20px; line-height: 24px; }
    .exp__row + .exp__row { margin-top: 53px; padding-top: 60px; }
  }
  @media (min-width: 1280px) {
    .exp { grid-template-columns: 495px 579px; padding: 120px 80px 240px 81px; }
    .exp__head { padding-top: 39px; }
    .exp__title { font-size: 80px; line-height: 64px; letter-spacing: -0.01em; }
    .exp__list { margin-top: 80px; }
    .exp__company { font-size: 24px; line-height: 28.8px; }
    .exp__role { margin-top: 15.2px; font-size: 32px; line-height: 32px; letter-spacing: -0.01em; }
    .exp__period { margin-top: 16px; font-size: 24px; line-height: 28.8px; }
    .exp__row + .exp__row { margin-top: 54.7px; padding-top: 59px; }
  }
</style>
