---
import { getCollection } from 'astro:content';
import { url } from '../data/site';
const projects = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
---
<section id="work" class="work frame" aria-label="Selected work">
  <ul class="work__grid" role="list">
    {projects.map((p, i) => (
      <li class="card" data-reveal>
        <a href={url(`work/${p.id}/`)} class="card__link">
          <div class="card__media">
            <img
              src={url(p.data.cover)}
              alt={p.data.coverAlt}
              loading={i < 2 ? 'eager' : 'lazy'}
              transition:name={`cover-${p.id}`}
            />
          </div>
          <div class="card__meta">
            <span class="card__tag">{p.data.tagline}</span>
            <span class="card__title" transition:name={`title-${p.id}`}>{p.data.title}</span>
          </div>
        </a>
      </li>
    ))}
  </ul>
</section>

<style>
  .work__grid { list-style: none; margin: 0; padding: 0; display: grid; }

  .card__link { display: block; }
  .card__media { height: 302px; background: var(--soft); overflow: hidden; }
  .card__media img { width: 100%; height: 100%; object-fit: cover; }

  .card__meta {
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    height: 66px; padding: 0 18px 0 16px;
  }
  .card__tag { font-weight: 500; font-size: 10px; line-height: 12px; letter-spacing: .6px; text-transform: uppercase; }
  .card__title { font-family: var(--serif); font-weight: 200; font-size: 18px; line-height: 1; letter-spacing: -0.004em; text-align: right; }

  /* Two columns; the right column sits 40px lower */
  @media (min-width: 800px) {
    .work { padding-bottom: 40px; }
    .work__grid { grid-template-columns: 1fr 1fr; }
    .card:nth-child(even) { position: relative; top: 40px; }
    .card__media { height: 311px; }
    .card__meta { height: 81px; padding: 0 20px; }
  }
  @media (min-width: 1280px) {
    .card__media { height: 528px; }
    .card__meta { height: 100px; }
    .card__title { font-size: 20px; }
  }
</style>
