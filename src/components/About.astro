---
import { facts, url } from '../data/site';
---
<section class="about frame" aria-labelledby="about-title">
  <h2 id="about-title" class="about__title" data-reveal>
    Some facts about me
    <img class="about__star" src={url('images/star.svg')} alt="" />
  </h2>

  <div class="about__copy" data-reveal>
    <p>
      Hi, I'm Dani — a Senior Product Designer from Costa Rica, currently living in Vienna. For the past 12+ years,
      I've been designing digital products that people actually enjoy using, across healthcare, e-commerce, and ed-tech.
    </p>
    <p>
      I love bringing ideas to life, from the first messy sketch to the final polished experience, working closely
      with cross-functional teams to create products that are intuitive, impactful, and genuinely useful.
    </p>
    <p>I care just as much about solving the right problem as I do about crafting beautiful interfaces.</p>
    <p>
      Outside of work, I'm usually illustrating, convincing my friends to try a new restaurant, or dancing like
      nobody's watching (because that's definitely more fun).
    </p>
  </div>

  <ul class="facts" role="list">
    {facts.map((f) => (
      <li class="fact" data-reveal>
        <p class="fact__text">{f.text}</p>
        <img class="fact__art" src={url(f.art)} alt="" loading="lazy" />
      </li>
    ))}
  </ul>
</section>

<style>
  .about { padding: 16px 24px 0; }
  .about__title {
    position: relative; margin: 0;
    font-family: var(--display); font-weight: 800;
    font-size: 80px; line-height: 64px; letter-spacing: -0.025em;
  }
  .about__star { position: absolute; left: 160px; top: 0; width: 36px; height: 36px; }

  .about__copy { margin-top: 40px; display: grid; gap: 34px; font-size: 18px; line-height: 25.2px; }

  .facts { list-style: none; margin: 55px 0 0; padding: 0; display: grid; gap: 28px; }
  .fact {
    position: relative; height: var(--h);
    background: var(--soft); border: 1px solid var(--card-line); border-radius: 16px;
    padding: 39px 23px 0; text-align: center; color: #121212;
    font-size: 18px; line-height: 25.2px;
  }
  .fact__art { position: absolute; left: 50%; top: calc(var(--top) - 1px); width: var(--w); height: var(--ih); translate: -50% 0; }

  /* Illustration size and placement per card, as in the design */
  .fact:nth-child(1) { --top: 106px; --w: 167px; --ih: 163px; }
  .fact:nth-child(2) { --top: 106px; --w: 163px; --ih: 163px; }
  .fact:nth-child(3) { --top: 120px; --w: 163px; --ih: 113px; }
  .fact:nth-child(4) { --top: 88px;  --w: 141px; --ih: 161px; }
  @media (max-width: 799px) {
    .fact:nth-child(1) { --h: 377px; }
    .fact:nth-child(2) { --h: 293px; }
    .fact:nth-child(3) { --h: 284px; }
    .fact:nth-child(4) { --h: 285px; }
  }

  @media (min-width: 800px) {
    .about {
      display: grid; grid-template-columns: 235px 365px; column-gap: 40px; align-items: start;
      padding: 16px 80px 80px;
    }
    .about__title { font-size: 72px; line-height: 57.6px; letter-spacing: -0.02em; }
    .about__star { left: 139px; }
    .about__copy { margin-top: 0; gap: 31px; font-size: 20px; line-height: 26px; }
    .facts { grid-column: 1 / -1; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-top: 56px; }
    .fact { --h: 226px; padding-top: 23px; font-size: 20px; line-height: 26px; }
    .fact:nth-child(1) { --top: 90px;  --w: 91px; --ih: 89px; }
    .fact:nth-child(2) { --top: 98px;  --w: 91px; --ih: 91px; }
    .fact:nth-child(3) { --top: 121px; --w: 91px; --ih: 63px; }
    .fact:nth-child(4) { --top: 124px; --w: 69px; --ih: 79px; }
  }
  @media (min-width: 1280px) {
    .about { grid-template-columns: 515px 565px; padding-bottom: 127px; }
    .about__title { font-size: 120px; line-height: 96px; letter-spacing: -0.01em; }
    .about__star { left: 241px; top: 13px; }
    .about__copy { gap: 28.8px; font-size: 24px; line-height: 28.8px; }
    .facts { gap: 28px; margin-top: 105px; }
    .fact { --h: 321px; padding-top: 39px; font-size: 24px; line-height: 28.8px; }
    .fact:nth-child(1) { --top: 108px; --w: 167px; --ih: 163px; }
    .fact:nth-child(2) { --top: 108px; --w: 163px; --ih: 163px; }
    .fact:nth-child(3) { --top: 151px; --w: 163px; --ih: 113px; }
    .fact:nth-child(4) { --top: 119px; --w: 141px; --ih: 161px; }
  }
</style>
