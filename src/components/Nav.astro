---
import { site, url } from '../data/site';
---
<header class="nav" transition:persist="nav">
  <nav class="frame" aria-label="Primary">
    <div class="pills">
      <a href={url('/')} class="pill pill--home" style={`background-image:url(${url('images/nav-home.svg')})`}>Home</a>
      <a href={site.linkedin} class="pill pill--in" target="_blank" rel="noopener">Linkedin</a>
      <a href={url(site.cv)} class="pill pill--cv" target="_blank" rel="noopener">CV</a>
    </div>
  </nav>
</header>

<style>
  .nav { position: fixed; inset: 0 0 auto 0; z-index: 100; pointer-events: none; }
  .pills { position: absolute; top: 4px; right: 24px; display: flex; pointer-events: auto; }
  .pill {
    display: grid; place-items: center; width: 56px; height: 56px;
    font-family: var(--body); font-weight: 500; font-size: 11.22px; line-height: 1.3;
  }
  .pill--home { background: center / 100% 100% no-repeat; color: #422307; }
  .pill--in { background: var(--orange); color: #000; }
  .pill--cv { background: #000; color: #fff; border-radius: 999px; }

  @media (min-width: 800px) {
    .pills { top: 0; right: 188px; }
    .pill { width: 80px; height: 80px; font-size: 16px; }
  }
  @media (min-width: 1280px) {
    .pills { right: 158px; }
  }
</style>
