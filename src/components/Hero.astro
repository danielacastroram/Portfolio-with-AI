---
import { site, url } from '../data/site';
const lines = ['Product', 'designer,', 'creative mind,', 'illustrator.'];
---
<section class="hero frame" data-hero>
  <p class="hero__name" data-hero-fade>{site.name}</p>

  <h1 class="hero__title" aria-label="Product designer, creative mind, illustrator.">
    {lines.map((l) => (
      <span class="line" aria-hidden="true"><span class="line-inner">{l}</span></span>
    ))}
  </h1>

  <img class="hero__star" src={url('images/star.svg')} alt="" data-hero-fade />
  <img class="hero__photo" src={url('images/avatar.png')} alt="Portrait of Daniela Castro" width="380" height="496" data-hero-fade />
  <img class="hero__burst" src={url('images/burst.svg')} alt="" data-hero-fade />

  <p class="hero__lede" data-hero-fade>
    12+ years of experience turning product and business challenges into digital experiences.
  </p>
</section>

<style>
  /* Positions are the design's own (x, y) in each frame */
  .hero { height: 664px; }
  .hero__name {
    position: absolute; left: 16px; top: 36px;
    font-family: var(--display); font-weight: 600; font-size: 20px; line-height: 1;
  }
  .hero__title {
    position: absolute; left: 16px; top: 190px; width: 311px; margin: 0;
    font-family: var(--display); font-weight: 800;
    font-size: 80px; line-height: 64px; letter-spacing: -0.008em;
  }
  .line { display: block; overflow: hidden; padding-bottom: .2em; margin-bottom: -.2em; }
  .line-inner { display: inline-block; will-change: transform; }
  .hero__star { position: absolute; left: 7px; top: 179px; width: 32px; height: 32px; }
  .hero__photo { position: absolute; left: 187px; top: 385px; width: 49px; height: 61px; border-radius: 14px; object-fit: cover; }
  .hero__burst { position: absolute; left: 281px; top: 395px; width: 90px; height: 90px; }
  .hero__lede {
    position: absolute; left: 16px; top: 526px; width: 343px;
    font-weight: 500; font-size: 16px; line-height: 1.3;
  }

  @media (min-width: 800px) {
    .hero { height: 599px; }
    .hero__name { left: 40px; top: 26px; font-size: 24px; }
    .hero__title { left: 40px; width: 389px; font-size: 72px; line-height: 57.6px; letter-spacing: -0.01em; }
    .hero__star { left: 66px; top: 180px; width: 28px; height: 28px; }
    .hero__photo { left: 305px; top: 180px; width: 95px; height: 117px; }
    .hero__burst { left: 388px; top: 275px; width: 62px; height: 62px; }
    .hero__lede { left: 40px; top: 436px; width: 259px; }
  }
  @media (min-width: 1280px) {
    .hero { height: 721px; }
    .hero__name { left: 80px; top: 24px; font-size: 32px; letter-spacing: -0.0032em; }
    .hero__title { left: 80px; width: 641px; font-size: 120px; line-height: 96px; letter-spacing: -0.012em; }
    .hero__star { left: 56px; top: 173px; width: 47px; height: 47px; }
    .hero__photo { left: 504px; top: 265px; width: 88px; height: 109px; }
    .hero__burst { left: 663px; top: 337px; width: 90px; height: 90px; }
    .hero__lede { left: 80px; top: 590px; width: 387px; }
  }
</style>
