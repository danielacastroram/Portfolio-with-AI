---
import { url } from '../data/site';
const lines = ['Product', 'designer,', 'creative', 'mind,', 'illustrator.'];
---
<section class="hero wrap" data-hero>
  <p class="hero__name eyebrow" data-hero-fade>Daniela Castro — Senior Product Designer</p>

  <h1 class="hero__title" aria-label="Product designer, creative mind, illustrator.">
    <svg class="hero__star" data-hero-star data-float="0.6" viewBox="0 0 40 40" aria-hidden="true">
      <path d="M20 0c1.6 10.4 9.6 18.4 20 20-10.4 1.6-18.4 9.6-20 20C18.4 29.6 10.4 21.6 0 20 10.4 18.4 18.4 10.4 20 0Z" fill="var(--orange)" />
    </svg>
    {lines.map((l, i) => (
      <span class="line" aria-hidden="true">
        <span class="line-inner">
          {l}
          {i === 3 && (
            <span class="hero__avatar" data-hero-avatar data-magnetic data-magnetic-strength="0.5">
              <img src={url('images/avatar.svg')} alt="" width="120" height="120" />
            </span>
          )}
        </span>
      </span>
    ))}
    <svg class="hero__burst" data-hero-burst data-float="-1" viewBox="0 0 100 100" aria-hidden="true">
      <path fill="var(--green)" d="M50 0l6 30 20-24-8 30 28-12-22 22 26 4-26 8 22 20-28-10 8 30-20-24-6 30-6-30-20 24 8-30-28 10 22-20-26-8 26-4-22-22 28 12-8-30 20 24z" />
    </svg>
  </h1>

  <div class="hero__foot">
    <p class="hero__lede" data-hero-fade>
      12+ years of experience turning product and business challenges into digital experiences.
    </p>
    <a href="#work" class="hero__badge" data-hero-fade data-magnetic data-cursor-label="Scroll" aria-label="Scroll to selected work">
      <svg viewBox="0 0 120 120" class="hero__badge-ring" aria-hidden="true">
        <defs><path id="ring" d="M60 60 m-46 0 a46 46 0 1 1 92 0 a46 46 0 1 1 -92 0" /></defs>
        <text><textPath href="#ring" textLength="284" lengthAdjust="spacing">Based in Vienna · From Costa Rica ·</textPath></text>
      </svg>
      <svg viewBox="0 0 24 24" class="hero__badge-arrow" aria-hidden="true"><path d="M12 4v16m0 0-6-6m6 6 6-6" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
    </a>
  </div>
</section>

<style>
  .hero {
    min-height: 100svh;
    display: flex; flex-direction: column; justify-content: flex-end;
    padding-top: 120px; padding-bottom: clamp(32px, 6vh, 72px);
  }
  .hero__name { margin: 0 0 clamp(16px, 3vh, 32px); color: #555; }
  .hero__title {
    position: relative; margin: 0;
    font-family: var(--display); font-weight: 800;
    font-size: clamp(52px, min(12.5vw, 14.5svh), 184px);
    line-height: .86; letter-spacing: -0.035em;
  }
  .line { display: block; overflow: hidden; padding-bottom: .16em; margin-bottom: -.16em; }
  .line-inner { display: inline-flex; align-items: center; gap: .12em; will-change: transform; }
  .hero__avatar {
    display: inline-block; width: .78em; height: .78em; border-radius: 50%;
    overflow: hidden; background: var(--lilac); transform: rotate(-6deg);
    box-shadow: 0 0 0 .04em var(--paper);
  }
  .hero__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .hero__star { position: absolute; width: .32em; left: -.18em; top: -.12em; }
  .hero__burst {
    position: absolute; width: .9em; right: max(0px, 18vw - 40px); bottom: .7em;
    animation: spin 24s linear infinite;
  }
  @keyframes spin { to { rotate: 360deg; } }

  .hero__foot { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; margin-top: clamp(28px, 5vh, 56px); }
  .hero__lede { margin: 0; max-width: 34ch; font-size: clamp(18px, 1.6vw, 22px); font-weight: 500; line-height: 1.35; }

  .hero__badge { position: relative; flex: none; width: 112px; height: 112px; display: grid; place-items: center; }
  .hero__badge-ring { position: absolute; inset: 0; animation: spin 16s linear infinite; }
  .hero__badge-ring text { font-family: var(--body); font-size: 11.5px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; fill: var(--ink); }
  .hero__badge-arrow { width: 26px; height: 26px; transition: transform .5s var(--ease-out); }
  .hero__badge:hover .hero__badge-arrow { transform: translateY(6px); }

  @media (max-width: 640px) {
    .hero__badge { width: 88px; height: 88px; }
    .hero__burst { right: 0; bottom: 1.2em; width: .7em; }
  }
</style>
