---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Cursor from '../components/Cursor.astro';
import { site, url } from '../data/site';

interface Props { title?: string; description?: string; image?: string }
const { title = site.title, description = site.description, image = 'og.png' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={url('favicon.svg')} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(url(image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#ffffff" />
    <script is:inline>
      // Only hide elements for animation when motion is welcome
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <ClientRouter fallback="swap" />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <div class="progress" aria-hidden="true" transition:persist="progress"><span></span></div>
    <Nav />
    <Cursor />
    <main id="main">
      <slot />
    </main>
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>

<style is:global>
  .progress { position: fixed; inset: 0 0 auto 0; height: 3px; z-index: 120; pointer-events: none; }
  .progress span { display: block; height: 100%; background: var(--orange); transform-origin: 0 50%; transform: scaleX(0); }

  ::view-transition-old(root), ::view-transition-new(root) { animation-duration: .55s; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
  ::view-transition-group(*) { animation-duration: .7s; animation-timing-function: cubic-bezier(0.22, 1, 0.36, 1); }
</style>
